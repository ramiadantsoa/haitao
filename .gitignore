# Quarto temporary artifacts
/.quarto/
# Quarto output directory for books
/_book/

_freeze/

# Optional: Common IDE and OS files
.Rproj.user
.jupyter_cache/
.DS_Store

# Ignore everything in MyDir
part_01_math/*
part_02_stat/*
part_03_code/*
temp/

# But do not ignore files directly within MyDir
!part_math/*.qmd
!part_stat/*.qmd
!part_code/*.qmd
**/*.quarto_ipynb


# Quarto generated output
_book/
_site/

# LaTeX intermediate files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.lof
*.lot

# PDF output (optional)
*.pdf

# email list number
email_list.numbers

# ignore pdf and docx from rendering (**/chap_* if any depth)
*/chap_*/